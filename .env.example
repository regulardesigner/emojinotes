# Copy to .env for local overrides. Every variable is optional in development.

# Port of the API server (Vite proxies /api to it in development).
PORT=3000

# Postgres connection string. When unset in development, a local SQLite file is used.
# Required in production.
# DATABASE_URL=postgres://emojinotes:emojinotes@localhost:5432/emojinotes

# TLS to Postgres: true (verified certificate), no-verify (encrypted, certificate not checked,
# for providers with self-signed certificates) or false.
# DATABASE_SSL=true

# Number of reverse proxies in front of the app, used by rate limiting to find the client IP.
# Set it to 1 on a PaaS (Render, Fly.io, Railway…), otherwise all users share one rate limit.
# Keep 0 when nothing sits in front of the app, or X-Forwarded-For can be spoofed.
# TRUST_PROXY=1
